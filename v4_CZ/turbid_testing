/*
  Analog Read for Phototransistor Circuit
  Pin A1: Connected to the node between the Phototransistor and Ro
*/

const int sensorPin = A1; // The pin where your output is connected
int sensorValue = 0;      // Variable to store the raw value (0-1023)
float voltage = 0;        // Variable to store the calculated voltage
float voltage_aftparallel = 0;
float R_eq=0;
void setup() {
  // Initialize serial communication at 9600 bits per second:
  Serial.begin(9600);
}

void loop() {
  // Read the input on analog pin A1:
  sensorValue = analogRead(sensorPin);

  // Convert the analog reading (0 - 1023) to a voltage (0 - 5V):
  voltage_aftparallel = sensorValue * (3.3 / 1023.0);

  R_eq = 1/(1/4.7+ 1/3.6); 
  voltage = voltage_aftparallel * (4.7/R_eq); 

  // Print out the values to the Serial Monitor:
  Serial.print("voltage_aftparallel: ");
  Serial.print(voltage_aftparallel);
  Serial.print(" | Voltage: ");
  Serial.println(voltage);

  delay(500); // Wait half a second for readability
}
