// Main Loop
void loop(){

    Watchdog.reset();

       // RTC Timer Event
    if (rtcTriggered){

        rtcTriggered = false;

        if(DEBUG_MODE){
            Serial.println(F("RTC TIMER EVENT"));
        }
        
        //Temporarily clear interrupts so 5v power does not self-trigger
        detachInterrupt(digitalPinToInterrupt(PIN_RTC_INT));

        reconfigureIntegratedPins();

        readTimerSensors();

        if(DEBUG_MODE){
            Serial.println(F("REARMING TIMER"));
        }

        rtc.deconfigureAllTimers();
        rtc.writeSqwPinMode(PCF8523_OFF); // Force release of rtc line back to high
        delay(100);
        rtc.enableCountdownTimer(PCF8523_FrequencySecond, 15);

        //Clear lingering interrupt flags
        EIC->INTFLAG.reg = (1 << g_APinDescription[PIN_RTC_INT].ulPin); 
        LowPower.attachInterruptWakeup(PIN_RTC_INT, isr_generic, FALLING);
    }
    // Process Digital Sensor Events
    if (flag_event_change){
        noInterrupts();
        flag_event_change = false;
        interrupts();

        reconfigureIntegratedPins();
        identifyAndLog();
    }

    // Bucket Timeout Reset
    if (bucketCount > 0 &&
        (millis() - lastBucketTime > 600000UL)) {
        bucketCount = 0;

        if (DEBUG_MODE){
            Serial.println(F("BUCKET RESET"));
        }
    }

    Watchdog.reset();

    // Power Management
    if (!DEBUG_MODE){
        powerSensorsOff();
        deactivateInterruptPins();
        
        LowPower.sleep();

        // Force Feather to wait until internal phase-locked loops stabilize
        for(volatile int i=0; i<500; i++) { asm("nop"); } 
        delay(100);
    }
    else{
        delay(200);
    }
}

//Pin Definition Helper Functions
void deactivateInterruptPins(){
    pinMode(PIN_SNS_BUCKET, INPUT);
    pinMode(PIN_SNS_LEAFSWITCH, INPUT);
    pinMode(PIN_SNS_FLOATTOP, INPUT);
    pinMode(PIN_SNS_FLOATBOT, INPUT);
    pinMode(PIN_SNS_CHLO, INPUT);
}

void reconfigureIntegratedPins(){
    pinMode(PIN_SNS_BUCKET, INPUT_PULLUP);
    pinMode(PIN_SNS_LEAFSWITCH, INPUT_PULLUP);
    pinMode(PIN_SNS_FLOATTOP, INPUT_PULLUP);
    pinMode(PIN_SNS_FLOATBOT, INPUT_PULLUP);
    pinMode(PIN_SNS_CHLO, INPUT);
}

// Interrupt Service Routines

void isr_bucket(){
    static unsigned long last_interrupt_time = 0;

    unsigned long interrupt_time = millis();

    if (interrupt_time - last_interrupt_time > 200){
        bucketCount++;

        lastBucketTime = interrupt_time;

        flag_event_change = true;
    }

    last_interrupt_time = interrupt_time;
}

void isr_generic(){
    flag_event_change = true;

    //If RTC induced wake-up, explicitly flag here
    if(digitalRead(PIN_RTC_INT)==LOW){
        rtcTriggered = true;
    }
}

void powerSensorsOn(){
    pinMode(PIN_BOOST_EN, OUTPUT); 
    
    digitalWrite(PIN_BOOST_EN, HIGH);
    PORT->Group[g_APinDescription[PIN_BOOST_EN].ulPort].PINCFG[g_APinDescription[PIN_BOOST_EN].ulPin].bit.INEN = 1;
    

    //delay(200);

    //explicit delay to overcome standby clock compression
    for (int i = 0; i < 30; i++) {
        delayMicroseconds(50000); // 30 * 50ms = Exactly 1,500ms (1.5 seconds) of warm-up
    }

}

void powerSensorsOff(){
    pinMode(PIN_BOOST_EN, OUTPUT);
    digitalWrite(PIN_BOOST_EN, LOW);
    PORT->Group[g_APinDescription[PIN_BOOST_EN].ulPort].PINCFG[g_APinDescription[PIN_BOOST_EN].ulPin].bit.INEN = 1;
    for (int i = 0; i < 4; i++) {
        delayMicroseconds(50000); 
    }
}

// Timed Sensors

void readTimerSensors(){
    
    powerSensorsOn();

    delay(500); //allow sensors to wake-up

    // Turbidity
//    int turbRaw = analogRead(PIN_ANALOG_TURB);

//    float turbVoltage = turbRaw * (3.3f / 4095.0f);

//    writeToCSV("TurbidityRaw",turbRaw);
//    writeToCSV("TurbidityVolt",turbVoltage);

    // Pressure
    analogRead(PIN_ANALOG_PRES); //Throw away first reading to reduce noise
