    float presVoltage = presRaw * (3.3f / 4095.0f);

    if(DEBUG_MODE){
        Serial.println(presRaw);
    }

    writeToCSV("PressureRaw",presRaw);
    writeToCSV("PressureVolt", presVoltage);

    powerSensorsOff();
}

// Event Sensors

void identifyAndLog(){
    static int lastLoggedBucket = 0;

    // Bucket Counter
    if (bucketCount != lastLoggedBucket){
        int currentCount = bucketCount;
        writeToCSV("BUCKET",currentCount);
        lastLoggedBucket = currentCount;
    }

    // Leaf Switch
    int currentLeaf = digitalRead(PIN_SNS_LEAFSWITCH);

    if (currentLeaf != lastLeaf){
        lastLeaf = currentLeaf;
        writeToCSV("LEAF", currentLeaf == LOW ?
            "PRESSED" :
            "LIFTED"
        );
    }

    // Float Top
    int currentTop = digitalRead(PIN_SNS_FLOATTOP);

    if (currentTop != lastTop){
        lastTop = currentTop;
        writeToCSV("FLOAT_TOP", currentTop == LOW ?
            "FAR" :
            "CLOSE"
        );
    }
   
   // Float Bottom
    int currentBot =digitalRead(PIN_SNS_FLOATBOT);

    if (currentBot != lastBot){
        lastBot = currentBot;
        writeToCSV(
            "FLOAT_BOT",
            currentBot == LOW ?
            "CLOSE" :
            "FAR"
        );
    }

    // Chlorine dispenser
    int currentChlo = digitalRead(PIN_SNS_CHLO);

    if (currentChlo != lastChlo){
        lastChlo = currentChlo; 
        writeToCSV(
            "CHLORINE",
            currentChlo == LOW ?
            "CHLO_OPEN":
            "CHLO_CLOSED"
        );
    }
}

