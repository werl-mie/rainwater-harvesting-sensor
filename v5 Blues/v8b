}

// Main CSV Writer

void writeToCSV(const char* sensorName, const char* sensorVal){
    uint32_t epoch = rtcz.getEpoch();

    char ts_human[25];

    snprintf(
        ts_human,
        sizeof(ts_human),
        "%04d-%02d-%02d %02d:%02d:%02d",
        rtcz.getYear() + 2000,
        rtcz.getMonth(),
        rtcz.getDay(),
        rtcz.getHours(),
        rtcz.getMinutes(),
        rtcz.getSeconds()
    );

    char logLine[128];

    snprintf(
        logLine,
        sizeof(logLine),
        "%s,%s,%lu,%s",
        ts_human,
        sensorName,
        (unsigned long)epoch,
        sensorVal
    );

    if (DEBUG_MODE){
        Serial.print(F("SD LOG: "));
        Serial.println(logLine);
    }

    File dataFile =
        SD.open("adata.csv", FILE_WRITE);

    if (dataFile){
        dataFile.println(logLine);
        dataFile.close();

        writeToNotecard(sensorName, sensorVal); //mirror data in Notecard queue

        digitalWrite(LED_BUILTIN, HIGH);
        delay(10);
        digitalWrite(LED_BUILTIN, LOW);
    }
    else{
        if (DEBUG_MODE){
            Serial.println(F("SD Write Failed"));
        }
    }
}

// Cellular 

void writeToNotecard(const char* sensorName, const char* sensorVal){
    
    J *req = notecard.newRequest("note.add"); // Create new request to queue data
    if (req == NULL){
        if (DEBUG_MODE){
            Serial.println(F("Failed to allocate Notecard request memory"));
        }
        return;
    }

    JAddStringToObject(req, "file", "sensors.qo"); //target file ".qo" (i.e. queue outbound, sending every 12hr)
    //JAddBoolToObject(req, "sync", true);

    J *body = JCreateObject();
    if (body == NULL){
        JDelete(req);
        return;
    }

    uint32_t epoch = rtcz.getEpoch(); // capture internal RTC time

    JAddStringToObject(body, "sensor", sensorName);
    JAddStringToObject(body, "value", sensorVal);
    JAddNumberToObject(body, "epoch", epoch);

    JAddItemToObject(req, "body", body); //attach body to request

    J *rsp = notecard.requestAndResponse(req);

    if (rsp != NULL) {
        char *json = JPrint(rsp);
        Serial.println("note.add response:");
        Serial.println(json);
        JFree(json);

        notecard.deleteResponse(rsp);
    } else {
        Serial.println("No response to note.add");
    }
    

}

